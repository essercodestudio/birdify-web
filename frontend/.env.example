# URL base da API REST (sem barra final). Em produção aponta para o domínio público.
# Dev: http://localhost:3001/api
# Prod: https://birdify.com.br/api
REACT_APP_API_URL=http://localhost:3001/api

# URL do Socket.io. Geralmente o mesmo host do site em produção.
# Dev: http://localhost:3001
# Prod: https://birdify.com.br
REACT_APP_SOCKET_URL=http://localhost:3001

# Base usada para servir uploads (logos de patrocinadores, etc).
# Em produção deixe vazio para usar caminho relativo (/uploads/...).
REACT_APP_MEDIA_URL=http://localhost:3001

# URL de marketing exibida no rodapé do Scorephoto (imagem compartilhável).
# Sem protocolo, formato "dominio.com.br" — troque se o domínio mudar.
REACT_APP_MARKETING_URL=birdify.com.br
