# Origens permitidas pelo CORS. Separe múltiplos domínios por vírgula.
# Ex: FRONTEND_URLS=https://birdify.com.br,https://staging.birdify.com.br
FRONTEND_URLS=https://birdify.com.br

# Compatibilidade legado (use FRONTEND_URLS para múltiplos)
# FRONTEND_URL=https://birdify.com.br

PORT=3001

# Banco de dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=golf_db

# URL pública do frontend — usada para montar links de e-mail (reset de senha).
# IMPORTANTE: em produção configure com https:// (ex.: https://birdify.com.br)
FRONTEND_URL=http://localhost:3000
